      "namedRegex": "^/api/approve(?:/)?$"
    },
    {
      "page": "/api/ask",
      "regex": "^/api/ask(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/ask(?:/)?$"
    },
    {
      "page": "/api/call",
      "regex": "^/api/call(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/call(?:/)?$"
    },
    {
      "page": "/api/chaos",
      "regex": "^/api/chaos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/chaos(?:/)?$"
    },
    {
      "page": "/api/ingest",
      "regex": "^/api/ingest(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/ingest(?:/)?$"
    },
    {
      "page": "/api/mock/stream",
      "regex": "^/api/mock/stream(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/mock/stream(?:/)?$"
    },
    {
      "page": "/api/office/socket",
      "regex": "^/api/office/socket(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/office/socket(?:/)?$"
    },
    {
      "page": "/api/peer",
      "regex": "^/api/peer(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/peer(?:/)?$"
    },
    {
      "page": "/api/realtime/session",
      "regex": "^/api/realtime/session(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/realtime/session(?:/)?$"
    },
    {
      "page": "/api/say",
      "regex": "^/api/say(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/say(?:/)?$"
    },
    {
      "page": "/chaos",
      "regex": "^/chaos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/chaos(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/oncall",
      "regex": "^/oncall(?:/)?$",
      "routeKeys": {},
